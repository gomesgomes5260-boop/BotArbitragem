# =====================================================
# Polymarket — credenciais de carteira (Polygon)
# =====================================================
# IMPORTANTE: use sempre uma carteira DEDICADA ao bot.
# Nunca reutilize a sua carteira pessoal. Crie uma nova
# e deposite apenas o capital destinado ao bot.
POLY_PRIVATE_KEY=
POLY_FUNDER_ADDRESS=

# =====================================================
# Polymarket — chaves de API (autenticacao L2 do CLOB)
# =====================================================
POLY_API_KEY=
POLY_API_SECRET=
POLY_API_PASSPHRASE=

# =====================================================
# RPC Polygon
# =====================================================
# Defaults para um RPC publico (rate-limited).
# Em producao, troque por Alchemy/QuickNode/Chainstack.
POLYGON_RPC_URL=https://polygon-rpc.com

# =====================================================
# Modelo de custos (Fase 2.5)
# =====================================================
# Fees em basis points (100 bps = 1%). Ajustar conforme
# politica vigente da Polymarket.
TAKER_FEE_BPS=0
MAKER_FEE_BPS=0

# Custos fixos mensais em USD (para amortizacao diaria).
MONTHLY_RPC_USD=0
MONTHLY_VPS_USD=10
MONTHLY_OTHER_USD=0

# Gas Polygon estimado por transacao (USD). Atualize se a rede subir.
# Valor tipico: 0.01-0.10 USD em condicoes normais.
AVG_GAS_POLYGON_USD=0.05
# Transacoes por arb (1 YES + 1 NO via Polymarket: ~2)
TXS_PER_ARB=2

# =====================================================
# Estrategia
# =====================================================
# Lucro liquido minimo (em %) para registrar uma
# oportunidade como acionavel.
MIN_NET_PROFIT_PCT=0.5

# Capital por trade (USDC) no paper trading. Limita
# tamanho simulado para testar com sizing realista.
PAPER_CAPITAL_PER_TRADE_USDC=20.0

# =====================================================
# Execucao real (Fase 5) - cuidado!
# =====================================================
# 0 = EOA (carteira simples), 1 = proxy Polymarket,
# 2 = Magic. Use 0 se nao tem motivo pra outro.
POLY_SIGNATURE_TYPE=0
POLY_CHAIN_ID=137
POLY_CLOB_HOST=https://clob.polymarket.com

# Limites de risco para LIVE TRADING. Comece pequeno.
LIVE_MAX_CAPITAL_PER_TRADE_USDC=5.0
LIVE_MAX_OPEN_EXPOSURE_USDC=20.0
LIVE_MAX_DAILY_LOSS_USDC=10.0
LIVE_MIN_USDC_BALANCE=10.0
# Cap absoluto por trade. CLI exige flag explicita
# pra ultrapassar este valor. NAO desligar sem motivo.
LIVE_CAPITAL_HARD_CAP_USDC=50.0

# Onde gravar o flag de kill-switch ativo. Quando esse
# arquivo existe, o bot recusa qualquer ordem nova.
KILL_SWITCH_PATH=data/KILL_SWITCH

# =====================================================
# Notion dashboard (opcional)
# =====================================================
# Token de integracao Notion (cria em https://www.notion.so/profile/integrations).
# Comeca com "secret_" ou "ntn_". Mantenha em segredo.
NOTION_TOKEN=
# IDs sao preenchidos pelo comando `bot notion-bootstrap` (ou manualmente).
NOTION_DASHBOARD_PAGE_ID=
NOTION_TRADES_DB_ID=
NOTION_OPPORTUNITIES_DB_ID=
# Intervalo entre syncs em modo --loop. Default 15 min (900s).
NOTION_SYNC_INTERVAL_SECONDS=900
# Quantas linhas novas processar por execucao (cap pra nao estourar
# rate limit de 3 req/s do Notion ao recuperar de longa janela offline).
NOTION_SYNC_MAX_ROWS_PER_RUN=50

# =====================================================
# Operacao
# =====================================================
LOG_LEVEL=INFO
DATABASE_PATH=data/bot.db
