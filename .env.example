# =====================================================
# Polymarket — credenciais de carteira (Polygon)
# =====================================================
# IMPORTANTE: use sempre uma carteira DEDICADA ao bot.
# Nunca reutilize a sua carteira pessoal. Crie uma nova
# e deposite apenas o capital destinado ao bot.
POLY_PRIVATE_KEY=
POLY_FUNDER_ADDRESS=

# =====================================================
# Polymarket — chaves de API (autenticacao L2 do CLOB)
# =====================================================
POLY_API_KEY=
POLY_API_SECRET=
POLY_API_PASSPHRASE=

# =====================================================
# RPC Polygon
# =====================================================
# Defaults para um RPC publico (rate-limited).
# Em producao, troque por Alchemy/QuickNode/Chainstack.
POLYGON_RPC_URL=https://polygon-rpc.com

# =====================================================
# Modelo de custos (Fase 2.5)
# =====================================================
# Fees em basis points (100 bps = 1%). Ajustar conforme
# politica vigente da Polymarket.
TAKER_FEE_BPS=0
MAKER_FEE_BPS=0

# Custos fixos mensais em USD (para amortizacao diaria).
MONTHLY_RPC_USD=0
MONTHLY_VPS_USD=10
MONTHLY_OTHER_USD=0

# =====================================================
# Estrategia
# =====================================================
# Lucro liquido minimo (em %) para registrar uma
# oportunidade como acionavel.
MIN_NET_PROFIT_PCT=0.5

# =====================================================
# Operacao
# =====================================================
LOG_LEVEL=INFO
DATABASE_PATH=data/bot.db
